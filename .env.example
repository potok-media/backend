# ==============================================================================
# potok-gateway — reference for docker-compose .env (create the file on the host)
# ==============================================================================

# Service port (mapped to container env PORT).
GATEWAY_PORT=5000

# ==============================================================================
# DATABASE (PostgreSQL) — Gateway owns the `potok-gateway` schema.
# DB_HOST=db uses the bundled container. Point at an external/shared instance to
# share one Postgres with potok-streaming (each owns its own schema).
# ==============================================================================
DB_HOST=db
DB_PORT=5432
DB_NAME=potok
DB_USER=potok
DB_PASSWORD=changeme

# TMDB API key (optional — a shared default is used when blank).
TMDB_API_KEY=

# Multi-user mode (allows self-registration of new users).
GATEWAY_MULTI_USER_MODE=false

# JWT signing secret for Gateway auth (change in production).
GATEWAY_JWT_SECRET=default-fallback-gateway-jwt-secret-key-32-chars-long

# Telegram login (optional). Set BOTH to enable sign-in/registration via Telegram.
GATEWAY_TELEGRAM_BOT_TOKEN=
GATEWAY_TELEGRAM_BOT_USERNAME=
